<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="YtDlpUi.Android.Views.HomeView">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="20,28,20,32" Spacing="16">
      <TextBlock Text="AFROWAVE" FontWeight="Bold" FontSize="14" Foreground="#53B5EE" />
      <TextBlock Text="Video &amp; audio" FontWeight="Bold" FontSize="30" />
      <TextBlock Text="Android 0.2.0 development preview · local yt-dlp"
                 FontSize="13" Foreground="#A0AABB" TextWrapping="Wrap" />

      <Border Background="#22314A" CornerRadius="14" Padding="16">
        <StackPanel Spacing="12">
          <TextBlock Text="Paste or share a video link" FontSize="18" FontWeight="SemiBold" />
          <TextBox Watermark="https://example.org/watch?v=..."
                   Text="{Binding Link, Mode=TwoWay}"
                   AcceptsReturn="False" FontSize="16" />
          <TextBlock Text="Quality (single stream; no FFmpeg needed)" FontSize="13" />
          <ComboBox ItemsSource="{Binding QualityOptions}"
                    SelectedItem="{Binding SelectedQuality, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Download" Command="{Binding DownloadCommand}" />
            <Button Content="Clear" Command="{Binding ClearLinkCommand}" />
          </StackPanel>
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}"
                       Height="8" />
          <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="14" />
        </StackPanel>
      </Border>

      <Border Background="#18273B" CornerRadius="14" Padding="16">
        <StackPanel Spacing="10">
          <TextBlock Text="Recent transfers" FontSize="18" FontWeight="SemiBold" />
          <Button Content="Open system Downloads" Command="{Binding OpenDownloadsCommand}"
                  HorizontalAlignment="Left" />
          <ItemsControl ItemsSource="{Binding RecentDownloads}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,3" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <TextBlock Text="Experimental local engine: supports many video sites via bundled Python + yt-dlp. Download success depends on the site. No FFmpeg merging, conversion, persistent queue or long-running foreground service yet."
                 Foreground="#A0AABB" TextWrapping="Wrap" FontSize="13" />
      <TextBlock Text="Permissions: Internet only. Android saves direct files to Downloads; yt-dlp exports completed files via MediaStore to Downloads/Afrowave. No all-files access."
                 Foreground="#A0AABB" TextWrapping="Wrap" FontSize="13" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
