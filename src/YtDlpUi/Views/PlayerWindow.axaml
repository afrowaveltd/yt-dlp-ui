<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:YtDlpUi.Localization"
        xmlns:vm="using:YtDlpUi.ViewModels"
        x:Class="YtDlpUi.Views.PlayerWindow"
        x:DataType="vm:PlayerViewModel"
        Title="{loc:Tr Key='Media player'}"
        Width="940" Height="680"
        MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">

  <Grid RowDefinitions="Auto,*,Auto" Margin="14">

    <!-- Header -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource AccentBrush}">
          <TextBlock Text="▶" FontSize="16" Foreground="#FFFFFF"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel VerticalAlignment="Center" Spacing="1">
          <TextBlock Text="{loc:Tr Key='Player'}" Classes="h1" />
          <TextBlock Classes="hint" Text="{Binding SystemPlayerHint}" MaxLines="1"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </StackPanel>

      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Content="{loc:Tr Key='Refresh'}" Command="{Binding RefreshCommand}" />
        <Button Content="{loc:Tr Key='Close'}" Classes="ghost" Click="OnCloseClick" />
      </StackPanel>
    </Grid>

    <!-- Body -->
    <Grid Grid.Row="1" ColumnDefinitions="300,*">

      <!-- File list -->
      <Border Grid.Column="0" Classes="surface" Padding="10">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Grid.Row="0" Text="{loc:Tr Key='Downloaded media'}" Classes="section" Margin="4,0,0,8" />

          <ListBox Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                   Background="Transparent">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="CornerRadius" Value="8" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:MediaItemViewModel">
                <Grid ColumnDefinitions="Auto,*">
                  <TextBlock Grid.Column="0" Text="{Binding Glyph}" FontSize="15" Margin="0,0,8,0"
                             VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{Binding FileName}" FontSize="12.5" MaxLines="2"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding UpdatedText}" Classes="hint" FontSize="10.5" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock Grid.Row="1" Text="{loc:Tr Key='No media files found in the download folder.'}"
                     Classes="hint" Margin="6,16,6,0" VerticalAlignment="Top"
                     IsVisible="{Binding HasItems, Converter={StaticResource InverseBool}}" />
        </Grid>
      </Border>

      <!-- Preview + details -->
      <Border Grid.Column="1" Classes="surface" Margin="12,0,0,0" Padding="14">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="10">

          <!-- Preview surface -->
          <Border Grid.Row="0" Height="300" CornerRadius="10" ClipToBounds="True"
                  Background="{DynamicResource CardAltBrush}">
            <Panel>
              <Image Source="{Binding PreviewFrame}" Stretch="Uniform" />
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                          IsVisible="{Binding HasVideo, Converter={StaticResource InverseBool}}">
                <TextBlock Text="🎵" FontSize="42" HorizontalAlignment="Center" />
                <TextBlock Text="{loc:Tr Key='This file has no picture to preview.'}"
                           Classes="hint" HorizontalAlignment="Center" />
              </StackPanel>
              <Border IsVisible="{Binding IsBusy}" Background="#66000000">
                <TextBlock Text="{loc:Tr Key='Loading preview…'}" VerticalAlignment="Center"
                           HorizontalAlignment="Center" Foreground="#FFFFFF" />
              </Border>
            </Panel>
          </Border>

          <!-- Scrubber -->
          <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10"
                IsVisible="{Binding CanScrub}">
            <TextBlock Grid.Column="0" Classes="mono" FontSize="11.5" VerticalAlignment="Center"
                       Text="{Binding PositionSeconds, StringFormat='{}{0:0.0} s'}" />
            <Slider Grid.Column="1" Minimum="0" Maximum="{Binding DurationSeconds}"
                    Value="{Binding PositionSeconds, Mode=TwoWay}" />
            <TextBlock Grid.Column="2" Classes="mono" FontSize="11.5" VerticalAlignment="Center"
                       Text="{Binding DurationSeconds, StringFormat='{}{0:0.0} s'}" />
          </Grid>

          <TextBlock Grid.Row="2" Text="{Binding StatusText}" Classes="hint" MaxLines="2" />

          <!-- Details -->
          <ScrollViewer Grid.Row="3">
            <StackPanel Spacing="10">
              <StackPanel Spacing="3">
                <TextBlock Classes="label" Text="{loc:Tr Key='File'}" />
                <TextBlock Text="{Binding Profile.FileName}" Classes="mono" TextWrapping="Wrap" />
              </StackPanel>

              <WrapPanel Orientation="Horizontal">
                <Border Classes="pill" Margin="0,0,6,6">
                  <TextBlock Classes="hint" FontSize="11.5"
                             Text="{Binding Profile.ResolutionText, FallbackValue='–'}" />
                </Border>
                <Border Classes="pill" Margin="0,0,6,6">
                  <TextBlock Classes="hint" FontSize="11.5" Text="{Binding Profile.VideoCodec, FallbackValue='–'}" />
                </Border>
                <Border Classes="pill" Margin="0,0,6,6">
                  <TextBlock Classes="hint" FontSize="11.5" Text="{Binding Profile.AudioCodec, FallbackValue='–'}" />
                </Border>
                <Border Classes="pill" Margin="0,0,6,6">
                  <TextBlock Classes="hint" FontSize="11.5"
                             Text="{Binding Profile.SizeBytes, Converter={StaticResource Bytes}, FallbackValue='–'}" />
                </Border>
                <Border Classes="pill" Margin="0,0,6,6">
                  <TextBlock Classes="hint" FontSize="11.5"
                             Text="{Binding Profile.DurationSeconds, Converter={StaticResource Duration}, FallbackValue='–'}" />
                </Border>
              </WrapPanel>

              <TextBlock Classes="hint" Text="{Binding Profile.Summary}" />
            </StackPanel>
          </ScrollViewer>

          <!-- Actions -->
          <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8">
            <Button Classes="primary" Content="{loc:Tr Key='▶  Play in system player'}"
                    Command="{Binding PlayCommand}" />
            <Button Content="{loc:Tr Key='Convert this file'}" Command="{Binding ConvertCommand}" />
            <Button Classes="ghost" Content="{loc:Tr Key='Open folder'}" Command="{Binding OpenFolderCommand}" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
