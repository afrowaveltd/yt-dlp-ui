<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:YtDlpUi.Localization"
             x:Class="YtDlpUi.Views.Pages.DownloadPage">

  <ScrollViewer>
    <StackPanel Margin="16,14,16,20" Spacing="14">

      <!-- ── Welcome / first run ── -->
      <Border Classes="card" IsVisible="{Binding ShowWelcome}"
              Background="{DynamicResource AccentSoftBrush}"
              BorderBrush="{DynamicResource AccentBrush}">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="6">
            <TextBlock Classes="h2" Text="{loc:Tr Key='Welcome! Download videos in three steps'}" />
            <TextBlock Classes="secondary"
                       Text="1) Vložte odkaz – klidně ho zkopírujte kdekoliv a tady se sám objeví.   2) Vyberte, zda chcete video nebo jen zvuk.   3) Stiskněte „Stáhnout“." />
            <TextBlock Classes="hint"
                       Text="Hotové soubory najdete ve složce, kterou vidíte níže. Vše ostatní (titulky, playlisty, kvalitu) najdete na dalších kartách." />
          </StackPanel>
          <Button Grid.Column="1" Classes="ghost" Content="{loc:Tr Key='Got it'}" VerticalAlignment="Top"
                  Command="{Binding DismissWelcomeCommand}" />
        </Grid>
      </Border>

      <!-- ── yt-dlp missing ── -->
      <Border Classes="card" IsVisible="{Binding !Toolchain.YtDlpAvailable}"
              Background="{DynamicResource WarningSoftBrush}"
              BorderBrush="{DynamicResource WarningBrush}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Grid.Column="0" Text="⚠" FontSize="20" Margin="0,0,12,0"
                     Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Spacing="3">
            <TextBlock Text="{loc:Tr Key='yt-dlp is not installed yet'}" FontWeight="SemiBold" />
            <TextBlock Classes="hint"
                       Text="Bez nástroje yt-dlp nelze nic stáhnout. Otevřete kartu Nástroje a nechte jej nainstalovat – je to otázka jednoho kliknutí." />
          </StackPanel>
          <Button Grid.Column="2" Classes="primary" Content="{loc:Tr Key='Open Tools'}"
                  Command="{Binding ShowToolsTabCommand}" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <!-- ══════════ 1. Link ══════════ -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <StackPanel Spacing="2">
            <TextBlock Classes="h2" Text="{loc:Tr Key='1 · Video link'}" />
            <TextBlock Classes="hint"
                       Text="{loc:Tr Key='Enter a video or playlist URL. You can also paste multiple links, one per line.'}" />
          </StackPanel>

          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBox Grid.Column="0" x:Name="UrlBox"
                     Text="{Binding Url, Mode=TwoWay}"
                     Watermark="https://www.youtube.com/watch?v=…"
                     FontSize="14" Padding="12,10" />
            <Button Grid.Column="1" Content="{loc:Tr Key='Paste'}" Click="OnPasteClick"
                    ToolTip.Tip="Vložit odkaz ze schránky" />
            <Button Grid.Column="2" Classes="primary" Content="{loc:Tr Key='Analyze'}"
                    Command="{Binding AnalyzeCommand}"
                    ToolTip.Tip="Zjistit název, délku a dostupné formáty (F5)" />
          </Grid>

          <!-- clipboard suggestion -->
          <Border Classes="cardAlt" Padding="10"
                  Background="{DynamicResource AccentSoftBrush}"
                  BorderBrush="{DynamicResource AccentBrush}"
                  IsVisible="{Binding ClipboardUrl, Converter={StaticResource StringNotEmpty}}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <TextBlock Grid.Column="0" Text="📋" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="1">
                <TextBlock Text="{loc:Tr Key='A link was found in the clipboard'}" FontWeight="Medium" FontSize="12.5" />
                <TextBlock Text="{Binding ClipboardUrl}" Classes="hint" MaxLines="1"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                <Button Classes="tiny" Content="{loc:Tr Key='Use'}" Command="{Binding AcceptClipboardUrlCommand}" />
                <Button Classes="ghost tiny" Content="✕" Command="{Binding DismissClipboardUrlCommand}"
                        ToolTip.Tip="{loc:Tr Key='Ignore'}" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- analysis error -->
          <Border Classes="cardAlt" Padding="10"
                  Background="{DynamicResource ErrorSoftBrush}"
                  BorderBrush="{DynamicResource ErrorBrush}"
                  IsVisible="{Binding AnalysisError, Converter={StaticResource StringNotEmpty}}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="✕" Foreground="{DynamicResource ErrorBrush}" FontWeight="Bold"
                         VerticalAlignment="Top" />
              <TextBlock Text="{Binding AnalysisError}" Foreground="{DynamicResource ErrorBrush}"
                         TextWrapping="Wrap" MaxWidth="620" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- ══════════ Preview ══════════ -->
      <Border Classes="card" IsVisible="{Binding HasInfo}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
          <Border Grid.Column="0" Width="208" Height="117" CornerRadius="10" ClipToBounds="True"
                  Background="{DynamicResource CardAltBrush}" VerticalAlignment="Top">
            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
          </Border>

          <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center">
            <TextBlock Text="{Binding Info.DisplayTitle, FallbackValue=''}" Classes="h2" MaxLines="3"
                       TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Info.Uploader, FallbackValue=''}" Classes="secondary" MaxLines="1"
                       TextTrimming="CharacterEllipsis" />

            <WrapPanel Orientation="Horizontal">
              <Border Classes="pill" Margin="0,0,6,6">
                <TextBlock Classes="hint" FontSize="12">
                  <TextBlock.Text>
                    <MultiBinding StringFormat="Délka: {0}">
                      <Binding Path="Info.Duration" Converter="{StaticResource Duration}" FallbackValue="–" />
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
              </Border>
              <Border Classes="pill" Margin="0,0,6,6">
                <TextBlock Classes="hint" FontSize="12">
                  <TextBlock.Text>
                    <MultiBinding StringFormat="Zhlédnutí: {0}">
                      <Binding Path="Info.ViewCount" FallbackValue="–" />
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
              </Border>
              <Border Classes="pill" Margin="0,0,6,6">
                <TextBlock Classes="hint" FontSize="12" Text="{Binding Info.Extractor, FallbackValue=''}" />
              </Border>
              <Border Classes="pill" Margin="0,0,6,6">
                <TextBlock Classes="hint" FontSize="12" Text="{Binding Info.UploadDate, FallbackValue=''}" />
              </Border>
            </WrapPanel>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ══════════ Playlist info ══════════ -->
      <Border Classes="card" IsVisible="{Binding InfoIsPlaylist}">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
              <TextBlock Text="{Binding Info.DisplayTitle, FallbackValue=''}" Classes="h2" MaxLines="2" />
              <TextBlock Classes="hint">
                <TextBlock.Text>
                  <MultiBinding StringFormat="Playlist s {0} položkami">
                    <Binding Path="Info.PlaylistCount" FallbackValue="0" />
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="📃" FontSize="22" VerticalAlignment="Center" />
          </Grid>

          <ListBox ItemsSource="{Binding PlaylistEntries}" MaxHeight="220"
                   Background="{DynamicResource CardAltBrush}" CornerRadius="8" Padding="6">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="MinHeight" Value="0" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <!-- ItemTemplate applies to every item; do not add a DataType matcher here.
                   A mismatched matcher makes Avalonia fall back to MediaEntry.ToString(). -->
              <DataTemplate>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="{Binding Display}" FontSize="12.5"
                             TextTrimming="CharacterEllipsis" MaxLines="1" />
                  <TextBlock Grid.Column="1" Text="{Binding Duration, Converter={StaticResource Duration}}"
                             Classes="hint" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock Classes="hint"
                     Text="Tip: rozsah položek (např. 1–10) nastavíte na kartě Playlist." />
        </StackPanel>
      </Border>

      <!-- ══════════ 2. Presets ══════════ -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <StackPanel Spacing="2">
            <TextBlock Classes="h2" Text="{loc:Tr Key='2 · What would you like to download?'}" />
            <TextBlock Classes="hint"
                       Text="{loc:Tr Key='Choose a preset. Technical details will be set automatically.'}" />
          </StackPanel>

          <ListBox ItemsSource="{Binding Presets}"
                   SelectedItem="{Binding SelectedPreset}"
                   Background="Transparent"
                   Padding="0">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Width="196" ColumnDefinitions="Auto,*">
                  <TextBlock Grid.Column="0" Text="{Binding Glyph}" FontSize="18"
                             Margin="0,0,10,0" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock Text="{Binding Description}" Classes="hint" MaxLines="2"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding CategoryLabel}" Classes="hint"
                               FontSize="10" FontWeight="SemiBold" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock Classes="hint">
            <TextBlock.Text>
              <MultiBinding StringFormat="Aktivní profil: {0}">
                <Binding Path="Options.PresetLabel" />
              </MultiBinding>
            </TextBlock.Text>
          </TextBlock>
        </StackPanel>
      </Border>

      <!-- ══════════ 3. Destination ══════════ -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <StackPanel Spacing="2">
            <TextBlock Classes="h2" Text="{loc:Tr Key='3 · Where to save the file'}" />
            <TextBlock Classes="hint"
                       Text="{loc:Tr Key='This is where your video or music will be saved. More options are on the Files tab.'}" />
          </StackPanel>

          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBox Grid.Column="0" Text="{Binding Options.OutputDirectory, Mode=TwoWay}"
                     Watermark="Složka pro ukládání" />
            <Button Grid.Column="1" Content="{loc:Tr Key='Browse…'}" Click="OnBrowseOutputFolderClick" />
            <Button Grid.Column="2" Content="{loc:Tr Key='Open'}" Command="{Binding OpenOutputFolderCommand}"
                    ToolTip.Tip="Otevřít složku ve správci souborů" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- ══════════ Actions ══════════ -->
      <Border Classes="card" Background="{DynamicResource CardAltBrush}">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Button Classes="primary" Content="⬇   Stáhnout" Command="{Binding DownloadCommand}"
                    Padding="26,11" FontSize="14"
                    ToolTip.Tip="Stáhnout hned (Ctrl+Enter)" />
            <Button Content="{loc:Tr Key='Add to queue'}" Command="{Binding EnqueueCommand}" />
            <Button Classes="ghost" Content="{loc:Tr Key='Clear'}" Command="{Binding ClearUrlCommand}" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Classes="hint"
                     VerticalAlignment="Center" MaxWidth="320" TextAlignment="Right" />
        </Grid>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
