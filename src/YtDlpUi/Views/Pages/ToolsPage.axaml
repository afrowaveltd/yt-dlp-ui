<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:YtDlpUi.Localization"
             x:Class="YtDlpUi.Views.Pages.ToolsPage">

  <ScrollViewer>
    <StackPanel Margin="16,14,16,20" Spacing="14">

      <!-- ══════════ yt-dlp status ══════════ -->
      <Border Classes="card">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Ellipse Grid.Column="0" Width="12" Height="12" Margin="0,0,12,0" VerticalAlignment="Center"
                     Classes.dot-ok="{Binding Toolchain.YtDlpAvailable}"
                     Classes.dot-missing="{Binding !Toolchain.YtDlpAvailable}" />
            <StackPanel Grid.Column="1" Spacing="2">
              <TextBlock Classes="h2" Text="yt-dlp" />
              <TextBlock Classes="hint" Text="{Binding Toolchain.YtDlpLocationText}"
                         TextTrimming="CharacterEllipsis" MaxLines="2" />
            </StackPanel>
            <Border Grid.Column="2" Classes="pill" VerticalAlignment="Center">
              <TextBlock Classes="mono" Text="{Binding Toolchain.YtDlpVersionText}" />
            </Border>
          </Grid>

          <Border Classes="cardAlt" Padding="10"
                  Background="{DynamicResource WarningSoftBrush}"
                  BorderBrush="{DynamicResource WarningBrush}"
                  IsVisible="{Binding Toolchain.YtDlpMissing}">
            <TextBlock Classes="secondary"
                       Text="{loc:Tr Key='yt-dlp was not found. You can install a personal copy below without administrator access.'}" />
          </Border>

          <Border Classes="cardAlt" Padding="10"
                  Background="{DynamicResource AccentSoftBrush}"
                  BorderBrush="{DynamicResource AccentBrush}"
                  IsVisible="{Binding Toolchain.UpdateHint, Converter={StaticResource StringNotEmpty}}">
            <TextBlock Text="{Binding Toolchain.UpdateHint}" Classes="secondary" />
          </Border>

          <WrapPanel Orientation="Horizontal">
            <Button Content="{loc:Tr Key='Check again'}" Command="{Binding Toolchain.RefreshCommand}"
                    Margin="0,0,8,8" />
            <Button Content="{loc:Tr Key='Update yt-dlp'}" Command="{Binding Toolchain.UpdateYtDlpCommand}"
                    Margin="0,0,8,8"
                    IsEnabled="{Binding Toolchain.YtDlpAvailable}"
                    ToolTip.Tip="Spustí yt-dlp --update" />
            <Button Content="{loc:Tr Key='Check for updates'}" Command="{Binding Toolchain.CheckLatestCommand}"
                    Margin="0,0,8,8" Classes="ghost" />
            <Button Content="{loc:Tr Key='Install with pip'}" Command="{Binding Toolchain.InstallViaPipCommand}"
                    Margin="0,0,8,8" Classes="ghost"
                    ToolTip.Tip="Použije pipx nebo pip" />
          </WrapPanel>

          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="{loc:Tr Key='Custom yt-dlp path (optional)'}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Grid.Column="0" Text="{Binding Settings.YtDlpPath, Mode=TwoWay}"
                       Watermark="{loc:Tr Key='Empty = detect automatically'}" />
              <Button Grid.Column="1" Content="{loc:Tr Key='Browse…'}" Click="OnBrowseYtDlpClick" />
            </Grid>
            <TextBlock Classes="hint"
                       Text="{loc:Tr Key='Click Check again after changing the path.'}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ══════════ Install ══════════ -->
      <Border Classes="card">
        <StackPanel Spacing="12">
          <StackPanel Spacing="2">
            <TextBlock Classes="h2" Text="{loc:Tr Key='Download and install yt-dlp'}" />
            <TextBlock Classes="hint"
                       Text="{loc:Tr Key='Downloads the official standalone program from GitHub to your user folder. No Python or administrator access required.'}" />
          </StackPanel>

          <WrapPanel Orientation="Horizontal">
            <Button Classes="primary" Content="{loc:Tr Key='Download and install'}"
                    Command="{Binding Toolchain.InstallStandaloneCommand}"
                    IsEnabled="{Binding Toolchain.IsBusy, Converter={StaticResource InverseBool}}"
                    Margin="0,0,8,8" />
            <Button Content="{loc:Tr Key='Stop'}" Classes="danger"
                    Click="OnCancelInstallClick"
                    IsVisible="{Binding Toolchain.IsBusy}"
                    Margin="0,0,8,8" />
          </WrapPanel>

          <StackPanel Spacing="4"
                      IsVisible="{Binding Toolchain.InstallProgress, Converter={StaticResource NotNull}}">
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding Toolchain.InstallProgress, FallbackValue=0, TargetNullValue=0}" />
            <TextBlock Classes="hint" Text="{Binding Toolchain.InstallProgress, StringFormat='{}{0:0} %'}" />
          </StackPanel>

          <TextBox Text="{Binding Toolchain.InstallLogText, Mode=OneWay}"
                   IsReadOnly="True" AcceptsReturn="True"
                   Height="130" TextWrapping="NoWrap"
                   FontFamily="{DynamicResource MonoFont}" FontSize="11.5"
                   IsVisible="{Binding Toolchain.InstallLogText, Converter={StaticResource StringNotEmpty}}" />

          <Border Classes="cardAlt">
            <StackPanel Spacing="4">
              <TextBlock Text="{loc:Tr Key='Manual installation'}" FontWeight="Medium" FontSize="12.5" />
              <TextBlock Classes="hint" TextWrapping="Wrap"
                         Text="Pokud dáváte přednost terminálu: pipx install yt-dlp · nebo pip install --user yt-dlp · nebo si stáhněte samostatný soubor z github.com/yt-dlp/yt-dlp/releases" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- ══════════ ffmpeg ══════════ -->
      <Border Classes="card">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Ellipse Grid.Column="0" Width="12" Height="12" Margin="0,0,12,0" VerticalAlignment="Center"
                     Classes.dot-ok="{Binding Toolchain.FfmpegAvailable}"
                     Classes.dot-missing="{Binding !Toolchain.FfmpegAvailable}" />
            <StackPanel Grid.Column="1" Spacing="2">
              <TextBlock Classes="h2" Text="ffmpeg" />
              <TextBlock Classes="hint" Text="{Binding Toolchain.FfmpegLocationText}"
                         TextTrimming="CharacterEllipsis" MaxLines="2" />
            </StackPanel>
            <TextBlock Grid.Column="2" Text="🎬" FontSize="18" VerticalAlignment="Center" />
          </Grid>

          <Border Classes="cardAlt" Padding="10"
                  Background="{DynamicResource WarningSoftBrush}"
                  BorderBrush="{DynamicResource WarningBrush}"
                  IsVisible="{Binding !Toolchain.FfmpegAvailable}">
            <StackPanel Spacing="4">
              <TextBlock Text="{loc:Tr Key='ffmpeg is not installed'}" FontWeight="SemiBold" />
              <TextBlock Classes="hint" TextWrapping="Wrap"
                         Text="{loc:Tr Key='FFmpeg is required to merge video and audio and to convert files to MP3. Install it using your package manager or use the installer below on Windows.'}" />
            </StackPanel>
          </Border>

          <Button Classes="primary" Content="{loc:Tr Key='Install FFmpeg for Windows'}"
                  Command="{Binding Toolchain.InstallFfmpegCommand}"
                  IsEnabled="{Binding Toolchain.IsBusy, Converter={StaticResource InverseBool}}"
                  IsVisible="{Binding Toolchain.CanInstallFfmpeg}"
                  HorizontalAlignment="Left" />

          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="{loc:Tr Key='Custom ffmpeg path (optional)'}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Grid.Column="0" Text="{Binding Settings.FfmpegPath, Mode=TwoWay}"
                       Watermark="{loc:Tr Key='Empty = detect automatically'}" />
              <Button Grid.Column="1" Content="{loc:Tr Key='Browse…'}" Click="OnBrowseFfmpegClick" />
            </Grid>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ══════════ App settings ══════════ -->
      <Border Classes="card">
        <StackPanel Spacing="12">
          <StackPanel Spacing="2">
            <TextBlock Classes="h2" Text="{loc:Tr Key='Application settings'}" />
            <TextBlock Classes="hint" Text="{loc:Tr Key='These settings are stored in your user configuration folder.'}" />
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Classes="label" Text="{loc:Tr Key='Interface language'}" />
            <WrapPanel Orientation="Horizontal">
              <Button Content="English" Command="{Binding UseEnglishCommand}" Margin="0,0,8,0" />
              <Button Content="Čeština" Command="{Binding UseCzechCommand}" />
            </WrapPanel>
            <TextBlock Classes="hint" Text="{loc:Tr Key='Language changes immediately and is remembered.'}" />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="{loc:Tr Key='Default download folder'}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Grid.Column="0" Text="{Binding Settings.DefaultOutputDirectory, Mode=TwoWay}" />
              <Button Grid.Column="1" Content="{loc:Tr Key='Browse…'}" Click="OnBrowseDefaultOutputClick" />
            </Grid>
          </StackPanel>

          <WrapPanel Orientation="Horizontal">
            <CheckBox Content="{loc:Tr Key='Automatically fill link from clipboard'}" MinWidth="330" Margin="0,0,16,6"
                      IsChecked="{Binding Settings.AutoFillFromClipboard}" />
            <CheckBox Content="{loc:Tr Key='Watch clipboard continuously'}" MinWidth="330" Margin="0,0,16,6"
                      IsChecked="{Binding Settings.WatchClipboardContinuously}" />
            <CheckBox Content="{loc:Tr Key='Analyze pasted links automatically'}" MinWidth="330" Margin="0,0,16,6"
                      IsChecked="{Binding Settings.AutoAnalyzeOnPaste}" />
            <CheckBox Content="{loc:Tr Key='Remember options between runs'}" MinWidth="330" Margin="0,0,16,6"
                      IsChecked="{Binding Settings.RememberOptions}" />
            <CheckBox Content="{loc:Tr Key='Dark mode'}" MinWidth="330" Margin="0,0,16,6"
                      IsChecked="{Binding Settings.DarkTheme}" />
            <CheckBox Content="{loc:Tr Key='Check for yt-dlp updates on startup'}" MinWidth="330" Margin="0,0,16,6"
                      IsChecked="{Binding Settings.CheckForYtDlpUpdates}" />
          </WrapPanel>

          <StackPanel Width="240" Spacing="4">
            <TextBlock Classes="label" Text="{loc:Tr Key='Concurrent downloads'}" />
            <TextBox Text="{Binding Settings.MaxConcurrentDownloads, Mode=TwoWay, Converter={StaticResource IntText}}" />
            <TextBlock Classes="hint" Text="{loc:Tr Key='1–4, recommended: 1 (clearer log)'}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ══════════ About ══════════ -->
      <Border Classes="card" Background="{DynamicResource CardAltBrush}">
        <StackPanel Spacing="6">
          <TextBlock Classes="h2" Text="{loc:Tr Key='About'}" />
          <TextBlock Classes="hint" TextWrapping="Wrap"
                     Text="{loc:Tr Key='yt-dlp GUI is a desktop frontend for yt-dlp. It has no ads or telemetry. Downloads go directly between your computer and the target website.'}" />
          <TextBlock Classes="hint" TextWrapping="Wrap"
                     Text="{loc:Tr Key='Source: github.com/yt-dlp/yt-dlp · Documentation and options: yt-dlp --help'}" />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
