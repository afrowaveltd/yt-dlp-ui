<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="YtDlpUi.Views.Pages.FormatPage">

  <ScrollViewer>
    <StackPanel Margin="16,14,16,20" Spacing="14">

      <Border Classes="card" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}">
        <StackPanel Spacing="2">
          <TextBlock Text="Formát a kvalita" Classes="h2" />
          <TextBlock Classes="secondary"
                     Text="Na kartě Stáhnout obvykle stačí vybrat profil. Tady můžete vše doladit – výběr streamu, převod kontejneru i zvuk." />
        </StackPanel>
      </Border>

      <!-- ══════════ Stream selection ══════════ -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <StackPanel Spacing="2">
            <TextBlock Classes="h2" Text="Výběr streamu" />
            <TextBlock Classes="hint"
                       Text="Přímo odpovídá volbě -f v terminálu. Prázdné pole nechá rozhodnutí na yt-dlp." />
          </StackPanel>

          <WrapPanel Orientation="Horizontal">
            <StackPanel Width="330" Margin="0,0,12,12" Spacing="4">
              <TextBlock Classes="label" Text="Formát (-f)" />
              <TextBox Text="{Binding Options.Format, Mode=TwoWay}"
                       Watermark="bv*+ba/b" FontFamily="{DynamicResource MonoFont}" />
              <TextBlock Classes="hint"
                         Text="bv*+ba/b = nejlepší video + nejlepší zvuk · b = nejlepší dohromady · ba = jen zvuk · 137+140 = konkrétní ID" />
            </StackPanel>

            <StackPanel Width="300" Margin="0,0,12,12" Spacing="4">
              <TextBlock Classes="label" Text="Řazení formátů (-S)" />
              <TextBox Text="{Binding Options.FormatSort, Mode=TwoWay}"
                       Watermark="res:1080,ext:mp4:m4a" FontFamily="{DynamicResource MonoFont}" />
              <TextBlock Classes="hint" Text="např. res:1080,ext:mp4:m4a,br" />
            </StackPanel>

            <StackPanel Width="260" Margin="0,0,12,12" Spacing="4">
              <TextBlock Classes="label" Text="Kontejner při slučování" />
              <ComboBox ItemsSource="{Binding MergeContainerOptions}"
                        SelectedItem="{Binding Options.MergeContainer, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Classes="hint" Text="MP4 přehraje téměř vše" />
            </StackPanel>
          </WrapPanel>

          <WrapPanel Orientation="Horizontal">
            <CheckBox Content="Uživatelské řazení má přednost" MinWidth="270"
                      IsChecked="{Binding Options.FormatSortForce}" Margin="0,0,16,6" />
            <CheckBox Content="Preferovat volné kontejnery" MinWidth="270"
                      IsChecked="{Binding Options.PreferFreeFormats}" Margin="0,0,16,6" />
            <CheckBox Content="Ověřit dostupnost formátů" MinWidth="270"
                      IsChecked="{Binding Options.CheckFormats}" Margin="0,0,16,6" />
            <CheckBox Content="Více video stop" MinWidth="270"
                      IsChecked="{Binding Options.VideoMultistreams}" Margin="0,0,16,6" />
            <CheckBox Content="Více zvukových stop" MinWidth="270"
                      IsChecked="{Binding Options.AudioMultistreams}" Margin="0,0,16,6" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <!-- ══════════ Audio ══════════ -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <StackPanel Spacing="2">
            <TextBlock Classes="h2" Text="Zvuk" />
            <TextBlock Classes="hint" Text="Převod na zvukový soubor (odpovídá -x v terminálu)." />
          </StackPanel>

          <CheckBox Content="Stahovat jen zvuk (vytáhnout audio stopu)" FontWeight="Medium"
                    IsChecked="{Binding Options.ExtractAudio}" />

          <WrapPanel Orientation="Horizontal">
            <StackPanel Width="220" Margin="0,0,12,12" Spacing="4">
              <TextBlock Classes="label" Text="Formát zvuku" />
              <ComboBox ItemsSource="{Binding AudioFormats}"
                        SelectedItem="{Binding Options.AudioFormat, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Width="220" Margin="0,0,12,12" Spacing="4">
              <TextBlock Classes="label" Text="Kvalita zvuku" />
              <TextBox Text="{Binding Options.AudioQuality, Mode=TwoWay}" Watermark="0–10 nebo 192K" />
              <TextBlock Classes="hint" Text="0 = nejlepší, 9 = nejhorší, nebo bitrate" />
            </StackPanel>
          </WrapPanel>
        </StackPanel>
      </Border>

      <!-- ══════════ Conversion ══════════ -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <StackPanel Spacing="2">
            <TextBlock Classes="h2" Text="Převod a úpravy videa" />
            <TextBlock Classes="hint" Text="Vyžaduje ffmpeg. Prázdné pole znamená „nepřevádět“." />
          </StackPanel>

          <WrapPanel Orientation="Horizontal">
            <StackPanel Width="250" Margin="0,0,12,12" Spacing="4">
              <TextBlock Classes="label" Text="Změnit kontejner bez rekomprese" />
              <TextBox Text="{Binding Options.RemuxVideo, Mode=TwoWay}" Watermark="mp4" />
              <TextBlock Classes="hint" Text="--remux-video – rychlé, beze ztráty kvality" />
            </StackPanel>

            <StackPanel Width="250" Margin="0,0,12,12" Spacing="4">
              <TextBlock Classes="label" Text="Překódovat do formátu" />
              <TextBox Text="{Binding Options.RecodeVideo, Mode=TwoWay}" Watermark="mkv" />
              <TextBlock Classes="hint" Text="--recode-video – pomalé, mění kvalitu" />
            </StackPanel>

            <StackPanel Width="300" Margin="0,0,12,12" Spacing="4">
              <TextBlock Classes="label" Text="Argumenty pro ffmpeg / postprocessing" />
              <TextBox Text="{Binding Options.PostprocessorArgs, Mode=TwoWay}"
                       Watermark="Merger+ffmpeg:-v quiet" FontFamily="{DynamicResource MonoFont}" />
              <TextBlock Classes="hint" Text="např. ExtractAudio+ffmpeg:-b:a 320k" />
            </StackPanel>
          </WrapPanel>

          <CheckBox Content="Ponechat původní soubor po převodu" IsChecked="{Binding Options.KeepVideo}" />
        </StackPanel>
      </Border>

      <!-- ══════════ Trimming ══════════ -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <StackPanel Spacing="2">
            <TextBlock Classes="h2" Text="Střih – jen část videa" />
            <TextBlock Classes="hint"
                       Text="Stáhne jen zadanou část. Formát: *OD-DO nebo název kapitoly. Například *10:15-20:00 nebo 1:05-1:30." />
          </StackPanel>

          <WrapPanel Orientation="Horizontal">
            <StackPanel Width="330" Margin="0,0,12,12" Spacing="4">
              <TextBlock Classes="label" Text="Časový rozsah nebo kapitola" />
              <TextBox Text="{Binding Options.DownloadSections, Mode=TwoWay}"
                       Watermark="*00:30-02:15" FontFamily="{DynamicResource MonoFont}" />
              <TextBlock Classes="hint" Text="*10:15-inf = od 10:15 do konce" />
            </StackPanel>

            <StackPanel Width="300" Margin="0,0,12,12" Spacing="4">
              <TextBlock Classes="label" Text="Odebrat kapitoly odpovídající regulárnímu výrazu" />
              <TextBox Text="{Binding Options.RemoveChapters, Mode=TwoWay}"
                       Watermark="^(Intro|Outro)" FontFamily="{DynamicResource MonoFont}" />
            </StackPanel>
          </WrapPanel>

          <CheckBox Content="Přesné střihy – vynutit klíčové snímky (pomalejší, ale čistší)"
                    IsChecked="{Binding Options.ForceKeyframesAtCuts}" />
        </StackPanel>
      </Border>

      <!-- ══════════ Available formats ══════════ -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
              <TextBlock Classes="h2" Text="Dostupné formáty" />
              <TextBlock Classes="hint" Text="Načte se po stisknutí „Analyzovat“ na první kartě." />
            </StackPanel>
            <Button Grid.Column="1" Content="Použít vybraný" Classes="primary"
                    Command="{Binding UseSelectedFormatCommand}"
                    IsEnabled="{Binding SelectedFormat, Converter={StaticResource NotNull}}" />
          </Grid>

          <ListBox ItemsSource="{Binding AvailableFormats}"
                   SelectedItem="{Binding SelectedFormat}"
                   MaxHeight="300" Background="{DynamicResource CardAltBrush}"
                   CornerRadius="8" Padding="6">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="8,5" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="MinHeight" Value="0" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Summary}" Classes="mono" TextWrapping="NoWrap" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
